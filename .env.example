# ==============================================================================
# 🎬 YouTube Automated Documentary Creator & Multi-Platform Marketing Agent
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Free API (Script, SEO & Marketing Copy)
# Get your free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Content & Language Configuration
# Supported languages: urdu, hindi, english
# (If not specified via CLI --topic, the agent pulls from topics.txt)
# ------------------------------------------------------------------------------
LANGUAGE=urdu
DEFAULT_TOPIC=The Mysterious Disappearance of Flight 370
TARGET_DURATION_MINUTES=2

# ------------------------------------------------------------------------------
# 3. Voiceover Configuration (edge-tts - 100% Free)
# Suggested Voices:
#   Urdu:    ur-PK-AsadNeural (Deep male), ur-PK-UzmaNeural (Female)
#   Hindi:   hi-IN-MadhurNeural (Documentary male), hi-IN-SwaraNeural (Female)
#   English: en-US-ChristopherNeural (Authoritative), en-US-GuyNeural
# ------------------------------------------------------------------------------
VOICE_NAME=ur-PK-AsadNeural
# Speech rate adjustment (e.g., -5% creates a deliberate, suspenseful documentary pace)
VOICE_RATE=-5%
# Pitch adjustment (e.g., -2Hz adds a deep, resonant tone)
VOICE_PITCH=-2Hz

# ------------------------------------------------------------------------------
# 4. Video & Audio Production Settings
# ------------------------------------------------------------------------------
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
# Background music volume relative to voiceover (0.12 = 12% volume)
BG_MUSIC_VOLUME=0.12

# ------------------------------------------------------------------------------
# 5. YouTube Data API v3 OAuth2 Credentials
# Run `python get_youtube_token.py` to easily obtain these values
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token

# Upload privacy status: private, unlisted, or public
YOUTUBE_PRIVACY_STATUS=private
# YouTube Category ID:
# 27 = Education, 28 = Science & Technology, 24 = Entertainment, 22 = People & Blogs
YOUTUBE_CATEGORY_ID=27

# Upload 9:16 vertical teaser video as a YouTube Short with #Shorts
UPLOAD_TEASER_SHORT=true

# ------------------------------------------------------------------------------
# 6. Multi-Platform Auto-Marketing & Social Distribution (Optional)
# If left blank, each platform is automatically and gracefully skipped!
# ------------------------------------------------------------------------------

# YouTube Pinned Comment (Auto-pinned question via YouTube Data API)
ENABLE_YOUTUBE_COMMENT=true

# Facebook Page Auto-Post (Facebook Graph API)
ENABLE_FACEBOOK_POST=true
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# X (Twitter) Thread Auto-Poster (X API v2 Free Tier)
ENABLE_TWITTER_THREAD=true
TWITTER_API_KEY=your_twitter_consumer_key
TWITTER_API_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret

# Telegram Channel Broadcast (Telegram Bot API - 100% Free)
ENABLE_TELEGRAM_BROADCAST=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_channel_username_or_chat_id

# ------------------------------------------------------------------------------
# 7. Operational & Dry Run Flags
# Set DRY_RUN=true to generate long video, teaser Short, thumbnail, and preview
# marketing copy in output/marketing_preview.json WITHOUT uploading or posting.
# ------------------------------------------------------------------------------
DRY_RUN=true

# Optional: Override paths to ffmpeg/ffprobe if not in system PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
